    "superweaponOnlyWins":   { "max": 0.05, "unit": "ratio" },
    "highestUnitPickRate":   { "max": 0.70, "unit": "ratio", "preferred": true },
    "lowestStdUnitPickRate": { "min": 0.10, "unit": "ratio", "preferred": true }
